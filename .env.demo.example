# ============================================================================
#  Fiduciary — DEMO instance environment template
#  Copy to ".env.demo" and fill in your own values. NEVER commit ".env.demo".
#
#  Run this as a SEPARATE Compose project from your real instance, against the
#  SAME docker-compose.yml (no forked compose file needed -- see the demo
#  entry in RESUME-TRACKER.md for the reasoning):
#
#    docker compose -p fiduciary-demo --env-file .env.demo up -d --build
#
#  `-p fiduciary-demo` namespaces the (auto-named) network and the
#  portfolio-data volume separately from your real `fiduciary` project. It does
#  NOT namespace the two explicit container_name values in docker-compose.yml
#  (Docker container names are global to the daemon) -- that's what
#  MCPO_CONTAINER_NAME/PORTFOLIO_CONTAINER_NAME below are for. Found 2026-07-26:
#  the first real run of this collided with the live instance's containers
#  before these two lines existed.
# ============================================================================

# ---- Container naming (2026-07-26) --------------------------------------------
# MUST differ from your real instance's container names (defaults
# fiduciary-mcpo / fiduciary-portfolio-api) or `up` fails with a "Conflict...
# name already in use" error -- container names are global to the Docker
# daemon, unlike the -p project namespace.
MCPO_CONTAINER_NAME=fiduciary-demo-mcpo
PORTFOLIO_CONTAINER_NAME=fiduciary-demo-portfolio-api

# ---- Demo harness (2026-07-25) ----------------------------------------------
# Turns on demo_seed.py: seeds a demo admin account + synthetic holdings on
# first boot (no code default is used for the password below -- always set
# your own for anything reachable by someone else).
DEMO_MODE=1
DEMO_ADMIN_USERNAME=demo
DEMO_ADMIN_PASSWORD=change-me-to-something-real
# How often the background thread wipes and reseeds fresh demo data (seconds).
# Default 21600 = 6 hours. Only fires if the demo marker file is present (see
# demo_seed.py) -- safe even if this .env is accidentally reused elsewhere.
DEMO_RESET_INTERVAL_S=21600

# ---- Internal auth tokens ----------------------------------------------------
MCPO_API_KEY=change-me-random-string

# ---- Session login ------------------------------------------------------------
# Set explicitly (don't leave blank) so the demo's session secret doesn't
# depend on the (disposable, periodically-wiped) data volume surviving.
SESSION_SECRET=change-me-random-string
SESSION_MAX_AGE_DAYS=1
SESSION_HTTPS_ONLY=0

# ---- In-app HTTPS -------------------------------------------------------------
# Leave the in-app TLS setup off for a demo fronted by its own reverse proxy
# or an AWS ALB (see AWS-DEMO-HOSTING-GUIDE.md); otherwise set these up from
# SETTINGS -> SECURITY -> Certificate after first boot, same as a real instance.
HTTPS_PORT=8444
# ^ MUST differ from your real instance's HTTPS_PORT (default 8443) if it also
# runs HTTPS on this host -- same port-collision class as DASH_PORT below.
ACME_EMAIL=
ACME_STAGING=0

# ---- Market & research data ---------------------------------------------------
# Leave these BLANK for a pure-synthetic demo -- the seeded holdings.csv
# doesn't need live prices to render a working dashboard, and leaving these
# unset means the demo never makes an outbound call with your real API keys.
# Set them only if you want the demo to show live-refreshing quotes.
FINNHUB_API_KEY=
TAVILY_API_KEY=
SEC_USER_AGENT=Fiduciary Demo you@example.com
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
RENTCAST_API_KEY=

# ---- Portfolio data source ------------------------------------------------------
# csv is the only sensible choice for a demo -- demo_seed.py seeds
# holdings.csv directly; monarch/snaptrade would need real, live third-party
# credentials, which have no place in a public demo instance.
PORTFOLIO_PROVIDER=csv

# ---- AI / LLM provider ----------------------------------------------------------
# Local Ollama (the default) works fine if the demo host has one reachable --
# otherwise point at the hybrid Anthropic path so chat/Strategist features
# work without a local model. Leave commented to disable those features
# gracefully rather than erroring.
# LLM_API_DIALECT=anthropic
# LLM_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_STRATEGIST_MODEL=claude-opus-5

# ---- Scheduling -------------------------------------------------------------------
# Recommended OFF for a demo -- there's no real reason for the internal
# scheduler to fire heavy recurring jobs against synthetic data nobody asked
# for, and it avoids unnecessary API/LLM calls on a public instance.
INTERNAL_SCHEDULER=0

# ---- Host port / timezone ----------------------------------------------------------
# MUST differ from your real instance's DASH_PORT (usually 8097) if running
# on the same host -- this is the actual thing (along with -p fiduciary-demo
# above) that keeps the two from colliding.
DASH_PORT=8098
TZ=America/Chicago
