# Dockerfile.demo -- builds the SAME portfolio-api image as portfolio-api/Dockerfile, but with
# compliance/ baked in at build time. Needed specifically for AWS Fargate (see
# AWS-DEMO-HOSTING-GUIDE.md): Fargate task definitions have no host to bind-mount from, unlike
# docker-compose.yml's local `./compliance:/compliance:ro` mount, which only works because Docker
# Compose runs on a host with that folder actually present.
#
# BUILD FROM THE REPO ROOT (not portfolio-api/), so this Dockerfile can reach both directories:
#   docker build -f Dockerfile.demo -t fiduciary-portfolio-api:demo .
#
# compliance/'s GRC content (risk register, Statement of Applicability, controls.json, ROPA, DPIA,
# IR runbook) IS committed to this repo (reversed 2026-07-26 — see .gitignore's compliance/ note
# and RESUME-TRACKER.md) — a normal git checkout already has everything this build needs, no manual
# population step required. Replace any of it with your own content before building if you want the
# Security Posture page to reflect a different deployment's actual controls.
#
# Otherwise identical to portfolio-api/Dockerfile -- keep the two in sync if that file changes
# (the acme.sh install step, base image, CMD, etc. are all duplicated here on purpose, since a
# multi-stage/shared-base setup would be more indirection than this one-off demo build is worth).

# Pinned to -bookworm (2026-07-27) -- see portfolio-api/Dockerfile's matching comment for the full
# reasoning (floating `python:3.12-slim` had silently rebased to Debian 13 "trixie", triggering a
# real Trivy CRITICAL finding; -bookworm is Debian 12, actively patched, and can't silently drift).
FROM python:3.12-slim-bookworm
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl tar socat ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/acmesh-official/acme.sh/archive/master.tar.gz -o /tmp/acme.tar.gz \
    && mkdir -p /tmp/acme-src && tar -xzf /tmp/acme.tar.gz -C /tmp/acme-src --strip-components=1 \
    && (cd /tmp/acme-src && ./acme.sh --install --force) \
    && rm -rf /tmp/acme.tar.gz /tmp/acme-src

COPY portfolio-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY portfolio-api/. .

# The one real difference from portfolio-api/Dockerfile: bake compliance/ into the image at a
# fixed path, and point COMPLIANCE_DIR (app.py's GET /api/compliance/controls, see app.py) at it.
# Everything else about that endpoint is unchanged -- it just reads from a different directory
# than the local bind-mount default (/compliance).
COPY compliance/ /compliance-baked/
ENV COMPLIANCE_DIR=/compliance-baked

EXPOSE 8097 8443
# Optional non-root run (2026-10-20, Checkov CKV_DOCKER_3). Default 0 = root, unchanged: on WSL/bind-mounted
# data directories a non-root uid hits file-ownership errors, so the live compose does not use it.
# Containers whose /data is managed by the platform (the AWS demo) can build with --build-arg APP_UID=10001.
ARG APP_UID=0
RUN if [ "$APP_UID" != "0" ]; then useradd --uid "$APP_UID" --no-create-home --shell /usr/sbin/nologin app \
      && mkdir -p /data && chown -R "$APP_UID" /app /data; fi
USER ${APP_UID}

# Liveness: any HTTP answer on the plain port counts (once HTTPS is on, 8097 answers with a 307 redirect);
# only a refused/hung connection fails. Compose or ECS may override this.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -s -o /dev/null --max-time 4 http://127.0.0.1:8097/ || exit 1
CMD ["python", "run_server.py"]
