    {
     "label": "FEES \u00b7 LIQUIDITY",
     "tab": "audits",
     "subtab": "fees",
     "role": "do"
    }
   ],
   "checks": [
    {
     "id": "G1",
     "label": "Employer match",
     "source": "benefits",
     "from": {
      "panel": "PLAN \u203a BENEFITS",
      "tab": "plan",
      "subtab": "benefits"
     },
     "let": {
      "setup": "setup_needed",
      "full": "sections.k401.match.full_capture",
      "left": "sections.k401.match.left_on_table",
      "needed": "sections.k401.match.needed_for_full_pct"
     },
     "rules": [
      {
       "when": [
        "setup",
        "==",
        true
       ],
       "state": "noinfo",
       "severity": "normal",
       "reason": "Not enough information yet: enter your salary and your 401(k) percentage.",
       "next": {
        "text": "Open BENEFITS.",
        "tab": "plan",
        "subtab": "benefits"
       }
      },
      {
       "when": [
        "full",
        "missing"
       ],
       "state": "noinfo",
       "severity": "low",
       "reason": "No employer match is entered.",
       "next": {
        "text": "Open BENEFITS.",
        "tab": "plan",
        "subtab": "benefits"
       }
      },
      {
       "when": [
        "full",
        "==",
        false
       ],
       "state": "attention",
       "severity": "high",
       "reason": "Your contributions earn only part of the employer match. About {left|usd} a year of match is not being collected; the full match needs {needed|n1}% of pay.",
       "next": {
        "text": "Open BENEFITS.",
        "tab": "plan",
        "subtab": "benefits"
       }
      },
      {
       "when": true,
       "state": "ok",
       "reason": "You are collecting the full employer match."
      }
     ]
    },
    {
     "id": "G4",
     "label": "One holding too large",
     "source": "rebalance",
     "from": {
      "panel": "RISK \u00b7 EXPOSURE \u203a POLICY \u00b7 DRIFT",
      "tab": "insights",
      "subtab": "drift"
     },
     "let": {
      "n": {
       "count": "concentration"
      }
     },
     "rules": [
      {
       "when": [
        "n",
        ">",
        0
       ],
       "state": "attention",
       "severity": "normal",
       "reason": "{n|n0} holding(s) are above the size limit you set.",
       "next": {
        "text": "See them in POLICY \u00b7 DRIFT.",
        "tab": "insights",
        "subtab": "drift"
       }
      },
      {
       "when": true,
       "state": "ok",
       "reason": "No holding is above the size limit you set."
      }
     ]
    }
   ]
