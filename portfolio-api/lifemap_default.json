     "id": "I1",
     "label": "On time for your goal",
     "source": "retirement",
     "from": {
      "panel": "PLAN \u203a FI \u00b7 MONTE CARLO",
      "tab": "plan",
      "subtab": "fi"
     },
     "let": {
      "fi": "fi_number",
      "age": "assumptions.current_age",
      "fiage": "fi_age",
      "target": "assumptions.target_age",
      "pct": "progress_pct",
      "late": {
       "sub": [
        "fi_age",
        "assumptions.target_age"
       ]
      }
     },
     "rules": [
      {
       "when": {
        "any": [
         [
          "fi",
          "missing"
         ],
         [
          "age",
          "missing"
         ]
        ]
       },
       "state": "noinfo",
       "severity": "high",
       "reason": "Not enough information yet: enter your birth year and yearly spending.",
       "next": {
        "text": "Open ASSUMPTIONS.",
        "tab": "plan",
        "subtab": "assumptions"
       }
      },
      {
       "when": [
        "late",
        ">",
        3
       ],
       "state": "attention",
       "severity": "high",
       "reason": "You are {pct|n0}% of the way to your number. At the current saving rate the projection reaches it at age {fiage|n0}; your goal is {target|n0}.",
       "next": {
        "text": "Open FI \u00b7 MONTE CARLO.",
        "tab": "plan",
        "subtab": "fi"
       }
      },
      {
       "when": [
        "late",
        ">=",
        1
       ],
       "state": "attention",
       "severity": "normal",
       "reason": "You are {pct|n0}% of the way to your number. At the current saving rate the projection reaches it at age {fiage|n0}; your goal is {target|n0}.",
       "next": {
        "text": "Open FI \u00b7 MONTE CARLO.",
        "tab": "plan",
        "subtab": "fi"
       }
      },
      {
       "when": true,
       "state": "ok",
       "reason": "You are {pct|n0}% of the way to your number, on pace for your goal age."
      }
     ]
    },
    {
     "id": "I2",
     "label": "Odds the money lasts",
     "source": "retirement",
     "from": {
      "panel": "PLAN \u203a FI \u00b7 MONTE CARLO",
      "tab": "plan",
      "subtab": "fi"
     },
     "let": {
      "p": "monte_carlo.success_pct"
     },
     "rules": [
      {
       "when": [
        "p",
        "missing"
       ],
       "state": "noinfo",
       "severity": "normal",
       "reason": "The simulation has not been run: it needs your spending and balances.",
       "next": {
        "text": "Open FI \u00b7 MONTE CARLO.",
        "tab": "plan",
        "subtab": "fi"
       }
      },
      {
       "when": [
        "p",
        "<",
        60
       ],
       "state": "attention",
       "severity": "high",
       "reason": "In the app's simulation the money lasts in {p|n0}% of the runs.",
       "next": {
        "text": "Open FI \u00b7 MONTE CARLO.",
        "tab": "plan",
        "subtab": "fi"
       }
      },
      {
       "when": [
        "p",
        "<",
        80
       ],
       "state": "attention",
       "severity": "normal",
       "reason": "In the app's simulation the money lasts in {p|n0}% of the runs.",
       "next": {
        "text": "Open FI \u00b7 MONTE CARLO.",
        "tab": "plan",
        "subtab": "fi"
       }
      },
      {
       "when": true,
       "state": "ok",
       "reason": "In the app's simulation the money lasts in {p|n0}% of the runs."
      }
     ]
    }
   ]
