# ============================================================================
#  Fiduciary — environment template
#  Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# ============================================================================

# ---- Internal auth tokens (generate your own random strings) ----------------
# Any long random value works, e.g.  openssl rand -hex 24
MCPO_API_KEY=change-me-random-string           # auth between portfolio-api and mcpo
ANALYSIS_TOKEN=change-me-random-string          # guards the portfolio-api /api/run-* endpoints (legacy —
                                                 # superseded by the session login below, kept as a harmless
                                                 # redundant check on those specific endpoints for now)

# ---- Session login (2026-07-23c) ---------------------------------------------
# The whole app now sits behind a real login (username/password + optional TOTP MFA, set up
# on first visit) instead of the old open-on-the-LAN model. SESSION_SECRET signs the session
# cookie — set your own random value for a real deployment (openssl rand -hex 32); if left
# blank, one is generated and saved to the data volume automatically so sessions still survive
# a restart, but setting it explicitly means the value doesn't depend on that file surviving.
SESSION_SECRET=
# How long a browser stays signed in.
SESSION_MAX_AGE_DAYS=30
# Set to 1 once this is served over HTTPS (e.g. behind a reverse proxy with TLS) — adds
# Strict-Transport-Security and marks the session cookie HTTPS-only. Leave 0 for plain local
# HTTP (the default docker-compose setup).
SESSION_HTTPS_ONLY=0

# ---- Market & research data (free tiers) ------------------------------------
# Finnhub  -> https://finnhub.io/  (free API key; used for quotes, valuation, volume)
FINNHUB_API_KEY=your-finnhub-key
# Tavily   -> https://tavily.com/  (free API key; used for the news-discovery agent)
TAVILY_API_KEY=your-tavily-key
# SEC EDGAR requires a descriptive User-Agent WITH a contact email or it returns 403.
SEC_USER_AGENT=Fiduciary you@example.com
# FINRA short interest -> https://developer.finra.org/ (free API-console account;
# create a PUBLIC-type API credential — "mock" only reaches FINRA's test datasets)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# RentCast home AVM -> https://www.rentcast.io/api (free tier, 50 calls/mo; the app
# caches ~30 days so one home costs ~1 call/mo)
RENTCAST_API_KEY=

# ---- Portfolio data source --------------------------------------------------
# Which provider feeds your holdings into the Fiduciary.
#   csv       = a local holdings.csv you maintain (no brokerage account needed)
#   monarch   = Monarch Money via mcpo (needs the MONARCH_* vars below)
#   snaptrade = one connection -> many brokerages, incl. Robinhood (SNAPTRADE_* below)
PORTFOLIO_PROVIDER=csv

# Only needed when PORTFOLIO_PROVIDER=monarch:
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=             # the TOTP secret from Monarch's authenticator setup

# Only needed when PORTFOLIO_PROVIDER=snaptrade. Dev signup -> https://snaptrade.com/
# gives CLIENT_ID + CONSUMER_KEY. Then run  python snaptrade_register.py  once to
# register a user, link brokerages, and get the USER_ID + USER_SECRET to paste below.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ---- Model / performance tuning (sensible defaults; override if needed) -----
ANALYSIS_MODEL=qwen3.6:27b      # the local Ollama model the analysis/strategist use
LLM_TIMEOUT=1200                # per-call ceiling (seconds) for the analysis model
LLM_KEEP_ALIVE=30m              # keep the model resident between calls
# STRAT_LLM_TIMEOUT=1800         # per-call ceiling for the weekly Strategist run
# MC_VOLATILITY_PCT=16           # Monte Carlo default volatility (set per your risk)

# ---- Scheduling (built into portfolio-api) ----------------------------------
# The recurring agents run on an internal scheduler — no external scheduler container.
# INTERNAL_SCHEDULER=0 turns it off entirely (run every job on demand instead).
# Job times are set in the dashboard under Settings -> Task Schedule; TZ (below) is the
# clock they fire on.
# INTERNAL_SCHEDULER=1

# ---- Host port / timezone ---------------------------------------------------
# Override DASH_PORT if you run another stack on the same host and 8097 clashes.
DASH_PORT=8097                  # portfolio-api dashboard on the host
TZ=America/Chicago              # clock for the built-in scheduler (and logs)
