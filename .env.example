# ============================================================================
#  Fiduciary — environment template
#  Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# ============================================================================

# ---- Internal auth tokens (generate your own random strings) ----------------
# Any long random value works, e.g.  openssl rand -hex 24
MCPO_API_KEY=change-me-random-string           # auth between portfolio-api and mcpo
ANALYSIS_TOKEN=change-me-random-string          # guards the portfolio-api /api/run-* endpoints

# ---- Market & research data (free tiers) ------------------------------------
# Finnhub  -> https://finnhub.io/  (free API key; used for quotes, valuation, volume)
FINNHUB_API_KEY=your-finnhub-key
# Tavily   -> https://tavily.com/  (free API key; used for the news-discovery agent)
TAVILY_API_KEY=your-tavily-key
# SEC EDGAR requires a descriptive User-Agent WITH a contact email or it returns 403.
SEC_USER_AGENT=Fiduciary you@example.com

# ---- Portfolio data source --------------------------------------------------
# Which provider feeds your holdings into the Fiduciary.
#   csv       = a local holdings.csv you maintain (no brokerage account needed)
#   monarch   = Monarch Money via mcpo (needs the MONARCH_* vars below)
#   snaptrade = one connection -> many brokerages, incl. Robinhood (SNAPTRADE_* below)
PORTFOLIO_PROVIDER=csv

# Only needed when PORTFOLIO_PROVIDER=monarch:
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=             # the TOTP secret from Monarch's authenticator setup

# Only needed when PORTFOLIO_PROVIDER=snaptrade. Dev signup -> https://snaptrade.com/
# gives CLIENT_ID + CONSUMER_KEY. Then run  python snaptrade_register.py  once to
# register a user, link brokerages, and get the USER_ID + USER_SECRET to paste below.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ---- Model / performance tuning (sensible defaults; override if needed) -----
ANALYSIS_MODEL=qwen3.6:27b      # the local Ollama model the analysis/strategist use
LLM_TIMEOUT=1200                # per-call ceiling (seconds) for the analysis model
LLM_KEEP_ALIVE=30m              # keep the model resident between calls
# STRAT_LLM_TIMEOUT=1800         # per-call ceiling for the weekly Strategist run
# MC_VOLATILITY_PCT=16           # Monte Carlo default volatility (set per your risk)

# ---- Host ports / timezone --------------------------------------------------
# Override these if you run another stack on the same host and the defaults clash.
# On Jason's host the main Local AI stack already uses 5678, so set N8N_PORT=5679.
DASH_PORT=8097                  # portfolio-api dashboard on the host
N8N_PORT=5678                   # n8n UI on the host  (Jason: set 5679 to avoid the main n8n)
TZ=America/Chicago
