# ============================================================================
#  Fiduciary — environment template
#  Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# ============================================================================

# ---- Internal auth tokens (generate your own random strings) ----------------
# Any long random value works, e.g.  openssl rand -hex 24
MCPO_API_KEY=change-me-random-string           # auth between portfolio-api and mcpo
# ANALYSIS_TOKEN removed 2026-07-26 -- the constant itself (not just its endpoint checks) was
# deleted from app.py on 2026-07-24; the session login below is the sole guard on every route now.
# If your existing .env still has an ANALYSIS_TOKEN= line, it's harmless to leave or delete.

# ---- Session login (2026-07-23c) ---------------------------------------------
# The whole app now sits behind a real login (username/password + optional TOTP MFA, set up
# on first visit) instead of the old open-on-the-LAN model. SESSION_SECRET signs the session
# cookie — set your own random value for a real deployment (openssl rand -hex 32); if left
# blank, one is generated and saved to the data volume automatically so sessions still survive
# a restart, but setting it explicitly means the value doesn't depend on that file surviving.
SESSION_SECRET=
# How long a browser stays signed in.
SESSION_MAX_AGE_DAYS=30
# Set to 1 if you're fronting this app with an EXTERNAL TLS-terminating reverse proxy this app
# doesn't manage itself — adds Strict-Transport-Security and marks the session cookie HTTPS-only.
# You do NOT need to set this for the app's own built-in HTTPS below (SETTINGS -> SECURITY ->
# Certificate) — that already flips this automatically once a certificate is active. Leave 0
# otherwise.
SESSION_HTTPS_ONLY=0

# ---- In-app HTTPS (2026-07-23f) -----------------------------------------------
# Three ways to get HTTPS, all set up from SETTINGS -> SECURITY -> Certificate in the dashboard
# itself — nothing below is required just to use them, these are optional overrides:
#   1. Self-signed  — instant, no prerequisites, browsers warn until you trust it manually.
#   2. Let's Encrypt / any ACME CA (PREFERRED when available) — via the vendored acme.sh client.
#   3. Manual — the app generates a CSR, you get it signed by any CA, paste the cert back in.
# The host port for HTTPS (only actually listening once a certificate exists; until then the
# app serves plain HTTP on DASH_PORT as it always has).
HTTPS_PORT=8443
# Contact email for the Let's Encrypt account (optional but recommended — used for expiry-
# warning emails if renewal ever silently stops working).
ACME_EMAIL=
# Use Let's Encrypt's STAGING CA (untrusted certs, no rate limits) — set to 1 the first time
# you're testing ACME issuance end to end, then back to 0 for a real certificate.
ACME_STAGING=0
# Only needed for ACME's http-01 challenge (acme.sh briefly binds it during issuance/renewal,
# then releases it) — leave the corresponding docker-compose.yml port mapping commented out
# unless you're using http-01 specifically (dns-01, self-signed, and manual-CSR don't need it).
ACME_HTTP01_PORT=80

# ---- Market & research data (free tiers) ------------------------------------
# Finnhub  -> https://finnhub.io/  (free API key; used for quotes, valuation, volume)
FINNHUB_API_KEY=your-finnhub-key
# Tavily   -> https://tavily.com/  (free API key; used for the news-discovery agent)
# PREFER THE UI (2026-07-24): SETTINGS -> SECRETS sets this from the dashboard and writes it to
# mcpo-secrets/mcpo.env for you -- `docker compose up -d mcpo` to apply (a plain `restart` reuses
# mcpo's existing environment and won't pick up the change). This .env value is only a fallback
# seed / disaster-recovery path, same as the AI-provider vars further down; leave blank to use the UI.
TAVILY_API_KEY=your-tavily-key
# SEC EDGAR requires a descriptive User-Agent WITH A REAL contact email or it returns 403.
# Put YOUR address here — leaving the you@example.com placeholder is the same as not setting it.
# This one string gates the ENTIRE EDGAR subsystem: the ticker->CIK map, company fundamentals,
# Form 4 insider signals, 8-K material events and NPORT fund look-through all fail together
# without it. As of 2026-08-08 that failure is reported honestly (a red "MISSING INPUT · SEC
# fundamentals" chip on the affected briefs, and GET /api/edgar-status); before that it was
# silently misreported as every ticker being "not SEC-registered".
SEC_USER_AGENT=Fiduciary you@example.com
# FINRA short interest -> https://developer.finra.org/ (free API-console account;
# create a PUBLIC-type API credential — "mock" only reaches FINRA's test datasets)
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# RentCast home AVM -> https://www.rentcast.io/api (free tier, 50 calls/mo; the app
# caches ~30 days so one home costs ~1 call/mo)
RENTCAST_API_KEY=

# ---- Portfolio data source --------------------------------------------------
# Which provider feeds your holdings into the Fiduciary.
#   csv       = a local holdings.csv you maintain (no brokerage account needed)
#   monarch   = Monarch Money via mcpo -- UNOFFICIAL, at your own risk; also needs an in-app risk
#               acknowledgment (SETTINGS -> ACCOUNTS) before it does anything
#   snaptrade = one connection -> many brokerages, incl. Robinhood (SNAPTRADE_* below)
PORTFOLIO_PROVIDER=csv

# Only needed when PORTFOLIO_PROVIDER=monarch. PREFER THE UI (2026-07-24): SETTINGS -> SECRETS
# sets these 3 from the dashboard (writes to mcpo-secrets/mcpo.env; `docker compose up -d mcpo` to
# apply -- a plain `restart` won't see the change) -- these .env values are only a fallback seed,
# same as Tavily above. Leave blank to use the UI.
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=             # the TOTP secret from Monarch's authenticator setup

# Only needed when PORTFOLIO_PROVIDER=snaptrade. Signup -> https://snaptrade.com/ gives CLIENT_ID +
# CONSUMER_KEY. PERSONAL key (CLIENT_ID starts with PERS-): nothing more is needed — leave USER_ID/SECRET
# blank and link brokerages in SETTINGS -> ACCOUNTS -> SnapTrade. COMMERCIAL key: run
# python snaptrade_register.py once and paste the USER_ID + USER_SECRET it prints below.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# ---- Model / performance tuning (sensible defaults; override if needed) -----
ANALYSIS_MODEL=qwen3.6:27b      # the local Ollama model the analysis/strategist use
LLM_TIMEOUT=1200                # per-call ceiling (seconds) for the analysis model
LLM_KEEP_ALIVE=30m              # keep the model resident between calls
# STRAT_LLM_TIMEOUT=1800         # per-call ceiling for the weekly Strategist run
# MC_VOLATILITY_PCT=16           # Monte Carlo default volatility (set per your risk)

# ---- AI / LLM provider (optional -- Claude integration, 2026-07-24) ---------
# PREFER THE UI: every var below is now also editable from SETTINGS -> AI / LLM PROVIDER
# (provider/host/model) and SETTINGS -> SECRETS (the two API keys, masked write-only) --
# no restart-editing-a-file-on-the-docker-host required. These .env values are only a fallback
# seed / disaster-recovery path; whatever's saved in the app's own DB wins once anything is
# saved there. Leave everything below blank/unset to keep the existing local-Ollama-only
# behavior -- nothing here is required.
#
# LLM_API_DIALECT=anthropic      # ollama (default) | openai | anthropic
# LLM_BASE_URL=                  # blank = provider default (https://api.anthropic.com for anthropic)
# LLM_API_KEY=                   # Anthropic: from console.anthropic.com -- NOT your claude.ai
#                                 # Pro/Max subscription, which has no API access. Pay-per-token,
#                                 # billed separately. platform.claude.com/docs/pricing for rates.
# ANTHROPIC_MODEL=claude-sonnet-5           # everyday tier: chat, Dashboard narrative
# ANTHROPIC_STRATEGIST_MODEL=claude-opus-5  # weekly Strategist run + cash-deployment advice
#
# Embeddings (Knowledge/RAG index) are a SEPARATE axis -- Anthropic has no embeddings API at
# all, so these stay on local Ollama by default even when LLM_API_DIALECT=anthropic above.
# Only set these if you want embeddings on a THIRD backend (e.g. an OpenAI-compatible
# embeddings host) independent of the chat provider.
# EMBED_API_DIALECT=openai       # ollama (default) | openai -- "anthropic" is invalid here
# EMBED_BASE_URL=
# EMBED_API_KEY=

# ---- Scheduling (built into portfolio-api) ----------------------------------
# The recurring agents run on an internal scheduler — no external scheduler container.
# INTERNAL_SCHEDULER=0 turns it off entirely (run every job on demand instead).
# Job times are set in the dashboard under Settings -> Task Schedule; TZ (below) is the
# clock they fire on.
# INTERNAL_SCHEDULER=1

# ---- Host port / timezone ---------------------------------------------------
# Override DASH_PORT if you run another stack on the same host and 8097 clashes.
DASH_PORT=8097                  # portfolio-api dashboard on the host
TZ=America/Chicago              # clock for the built-in scheduler (and logs)

# ---- Emergency access: TEST MODE (TASK-002) ---------------------------------
# !!! DO NOT SET THIS ON A REAL DEPLOYMENT !!!
# EMERGENCY_ALLOW_SHORT_WAIT=1 lets the emergency-access "wait" be a few SECONDS and BYPASSES the
# 24-hour minimum wait, the 24-hour cool-down on widening changes, and the "you must be reachable"
# notification gate. It exists only so the full request -> grant flow can be exercised in minutes in
# a throwaway scratch container. The app prints a warning at startup, records an
# `emergency.test_mode_active` audit event, and shows a red banner in SETTINGS -> IAM when it is on.
# Leave it unset (default: off).
# EMERGENCY_ALLOW_SHORT_WAIT=0
