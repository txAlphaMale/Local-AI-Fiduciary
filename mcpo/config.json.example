{
  "_comment": "Copy to config.json BEFORE the first `docker compose up` (mcpo crash-loops if the bind-mount source is missing). Fiduciary stack only. 'monarch' is used ONLY when PORTFOLIO_PROVIDER=monarch (its credentials come from the MONARCH_* env vars, not this file). Tavily news search no longer goes through mcpo (the app calls Tavily directly; set the key in SETTINGS -> SECRETS & KEYS), so there is no 'tavily' entry here.",
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=America/Chicago"]
    },
    "monarch": {
      "command": "uvx",
      "args": ["monarch-mcp-jamiew"]
    }
  }
}
