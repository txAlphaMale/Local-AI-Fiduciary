{
  "_comment": "Copy to config.json BEFORE the first `docker compose up` (mcpo crash-loops if the bind-mount source is missing). Fiduciary stack only. 'monarch' is used ONLY when PORTFOLIO_PROVIDER=monarch (its credentials come from the MONARCH_* env vars, not this file). 'tavily' is now only a FALLBACK: the app calls Tavily directly (2026-10-21) and uses this entry only when the app itself has no Tavily key (key present only in mcpo's environment). 'time' is a harmless helper.",
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=America/Chicago"]
    },
    "tavily": {
      "command": "uvx",
      "args": ["--from", "mcp-tavily", "--with", "mcp<2", "python", "-m", "mcp_server_tavily"]
    },
    "monarch": {
      "command": "uvx",
      "args": ["monarch-mcp-jamiew"]
    }
  }
}
