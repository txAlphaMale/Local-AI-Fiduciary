# Copy to backend.hcl (gitignored) -- or paste `terraform -chdir=bootstrap output -raw backend_hcl`.
# Shared by persistent/ and demo-env/; each stack sets its own `key` in its backend block.
bucket       = "fiduciary-demo-tfstate-<ACCOUNT_ID>"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking (Terraform >= 1.10) -- no DynamoDB table needed
